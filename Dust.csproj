<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Dust</AssemblyName>
    <RootNamespace>Dust</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Dust.ico</ApplicationIcon>
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Audio\*.wav">
      <LogicalName>Dust.Audio.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="track.ogg">
      <LogicalName>Dust.Audio.track.ogg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools\ObjectiveQa\**\*.cs" />
    <Compile Remove="tools\StorageFixtureQa\**\*.cs" />
    <Compile Remove="tools\TutorialQa\**\*.cs" />
    <Compile Remove="OnlineServer\**\*.cs" />
  </ItemGroup>
</Project>
